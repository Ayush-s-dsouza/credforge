# credforge configuration -- copy to .env and fill in as needed.
# Nothing here is required for `credforge run/batch --dry-run` (research
# only, stops at GATE) or `credforge resolve`.

# Vault encryption key (cryptography.fernet). Required for `run`/`batch`
# WITHOUT --dry-run, even with mocked (non-live) provisioning -- the mock
# browser/email swap is about --live, not about whether a credential (a
# mock one, if not --live) gets written to the vault. Generate with:
#   python -c "from credforge.vault.crypto_vault import generate_key; print(generate_key())"
CREDFORGE_VAULT_KEY=

# Real web search (RESOLVE/DISCOVER) uses the no-key `ddgs` (DuckDuckGo)
# provider by default -- nothing to set here for that. Set this only if you
# want Brave Search instead (a documented API with predictable rate limits,
# but Brave requires a card on file since Feb 2026, even for its free tier).
# Deliberately unprefixed -- it's the same key a human would set for any tool
# using this API, not a credforge-specific knob.
BRAVE_API_KEY=

# LLM-assisted extraction (DISCOVER/CLASSIFY). Without this, the deterministic
# heuristic extractor is used instead. Also deliberately unprefixed.
ANTHROPIC_API_KEY=

# --live provisioning only (Stage 5-6). Ignored otherwise.
CREDFORGE_IMAP_HOST=
CREDFORGE_IMAP_PORT=993
CREDFORGE_IMAP_USER=
CREDFORGE_IMAP_PASSWORD=
CREDFORGE_EMAIL_ALIAS_DOMAIN=example.com
